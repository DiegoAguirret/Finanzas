// Configuración del Worker de Cloudflare «finanzas» (https://finanzas.diego-aguito.workers.dev).
// Cloudflare compila con «python3 construir.py» y publica con «npx wrangler deploy», que lee este archivo.
{
  "name": "finanzas",
  "main": "trabajador/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El Worker atiende todas las peticiones para añadir las cabeceras de seguridad a la web
    "run_worker_first": true
  },
  // Las variables SUPABASE_URL y SUPABASE_CLAVE se configuran en el panel de Cloudflare: no borrarlas al publicar
  "keep_vars": true
}
